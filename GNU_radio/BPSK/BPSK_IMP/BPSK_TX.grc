- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: "import numpy as np, struct, binascii\n\nPAYLOAD = 64\nTX_FILE = \"bpsk_transmit.txt\"\
      \n\ndef generate_data():\n    TEXT = \"Hello world\"\n    txt  = TEXT.encode(\"\
      ascii\")\n    assert len(txt) <= PAYLOAD - 1\n\n    # one 64-byte packet: [length][text][zero\
      \ padding]\n    packet = (bytes([len(txt)]) + txt).ljust(PAYLOAD, b\"\\x00\"\
      )\n\n    return packet * 20                   # repeat so several packets get\
      \ through\n\ndata = generate_data()\ndata += b\"\\x00\" * ((-len(data)) % PAYLOAD)\
      \   # safety: keep a multiple of 64\n\nwith open(TX_FILE, \"wb\") as f:\n  \
      \  f.write(data)"
    comment: Create transmit file
    priority: '0'
    section: init_before_blocks
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 152.0]
    rotation: 0
    state: enabled
