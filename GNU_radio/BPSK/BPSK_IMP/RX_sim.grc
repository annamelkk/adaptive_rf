- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import time\nimport struct\nimport binascii\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Finds the\
      \ sync word in a bit stream, then decodes length + text + CRC16.\"\"\"\n\n \
      \   def __init__(self, sync_hex=\"1ACFFC1D\"):\n        gr.sync_block.__init__(self,\
      \ name=\"Frame Decoder\",\n                               in_sig=[np.uint8],\
      \ out_sig=None)\n        sync_bits = np.unpackbits(np.frombuffer(bytes.fromhex(sync_hex),\
      \ dtype=np.uint8))\n        self.sync_pm = 2 * sync_bits.astype(np.int16) -\
      \ 1   # +1/-1 pattern\n        self.n = len(sync_bits)\n        self.buf = np.zeros(0,\
      \ dtype=np.uint8)\n        self.good = 0\n        self.bad = 0\n        self.total\
      \ = 0\n        self.last_print = 0.0\n        self.last_status = time.time()\n\
      \n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        self.total += len(x)\n        self.buf = np.concatenate((self.buf,\
      \ x & 1))\n        self._scan()\n        if time.time() - self.last_status >\
      \ 1.0:\n            self.last_status = time.time()\n            print(\"[status]\
      \ bits=%d good=%d bad=%d\" % (self.total, self.good, self.bad))\n        return\
      \ len(x)\n\n    def _scan(self):\n        n = self.n\n        while len(self.buf)\
      \ >= n:\n            s = 2 * self.buf.astype(np.int16) - 1\n            c =\
      \ np.correlate(s, self.sync_pm, mode=\"valid\")\n            hits = np.where(np.abs(c)\
      \ >= n - 2)[0]      # allows 1 bit error\n            if len(hits) == 0:\n \
      \               self.buf = self.buf[-(n - 1):]\n                return\n   \
      \         h = hits[0]\n            start = h + n\n            if len(self.buf)\
      \ < start + 8:               # wait for more bits\n                self.buf\
      \ = self.buf[h:]\n                return\n            bits = self.buf[start:]\n\
      \            if c[h] < 0:                                # inverted polarity\n\
      \                bits = 1 - bits\n            length = int(np.packbits(bits[:8])[0])\n\
      \            total = 8 + 8 * length + 16                 # length + payload\
      \ + CRC\n            if len(bits) < total:\n                self.buf = self.buf[h:]\n\
      \                return\n            data = np.packbits(bits[:total]).tobytes()\n\
      \            body = data[:-2]\n            crc = struct.unpack(\">H\", data[-2:])[0]\n\
      \            if crc == binascii.crc_hqx(body, 0xFFFF):\n                self.good\
      \ += 1\n                self.buf = self.buf[start + total:]\n              \
      \  if time.time() - self.last_print > 0.5:\n                    self.last_print\
      \ = time.time()\n                    text = body[1:].decode(\"ascii\", errors=\"\
      replace\")\n                    print(\"[good %d, bad %d] %s\" % (self.good,\
      \ self.bad, text))\n            else:\n                self.bad += 1\n     \
      \           self.buf = self.buf[h + 1:]"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sync_hex: '   "1ACFFC1D"'
  states:
    _io_cache: ('Frame Decoder', 'blk', [('sync_hex', "'1ACFFC1D'")], [('0', 'byte',
      1)], [], 'Finds the sync word in a bit stream, then decodes length + text +
      CRC16.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2168, 384.0]
    rotation: 0
    state: enabled
